# ── LLM ──
LLM_PRIMARY=deepseek
LLM_FALLBACK=qwen
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=sk-your-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Embedding ──
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Database ──
# SQLite (开发): sqlite+aiosqlite:///data/med_assist.db
# PostgreSQL (生产): postgresql+asyncpg://user:pass@localhost:5432/med_assist
DATABASE_URL=sqlite+aiosqlite:///data/med_assist.db

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Chroma ──
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=med_manuals

# ── LangFuse ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:18922

# ── Circuit Breaker ──
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30

# ── GPTCache ──
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=3600

# ── JWT ──
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=1440

# ── Logging ──
LOG_FORMAT=console
ENV=development
